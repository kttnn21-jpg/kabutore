# kabuステーションAPI
KABU_API_BASE_URL=http://localhost:18080/kabuapi
KABU_API_PASSWORD=your_password_here

# 安全装置（必須）
MAX_ORDERS_PER_DAY=10
MAX_DAILY_LOSS_PCT=2.0
MAX_POSITIONS=3
MAX_YEN_PER_SYMBOL=100000

# 運用設定
STOP_FILE=STOP
LOOP_INTERVAL_SEC=30
OUT_OF_MARKET_SLEEP_SEC=60
ERROR_MAX_COUNT=3

# 保存先
LOG_DIR=data/logs
STATE_DIR=data/state
